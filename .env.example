NEXT_PUBLIC_APP_URL=""

# ── Database ────────────────────────────────────────────
# Managed Postgres (Supabase/Neon, public CA): keep verify-full — this is the
# behavior pg already applies today and stays correct for pg v9.
# DATABASE_URL = pooled (runtime via Neon -pooler host). Used by lib/prisma.ts.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# DIRECT_URL = direct non-pooled (migrate/CLI only). Neon Console → Connect →
# pooling OFF (host WITHOUT -pooler, port 5432). Required in Vercel
# Production + Preview; prisma.config.ts fails fast if missing so migrate
# never silently runs through the pooler (P1002 advisory lock).
DIRECT_URL="postgresql://user:password@ep-xxxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Local Postgres without SSL: drop the param or use ?sslmode=disable.
# Self-signed / private CA: ?sslmode=verify-full&sslrootcert=/path/to/ca.crt
# Do NOT use uselibpqcompat=true (weakens verification, Node-only, rejected by
# psql/pgx) or sslrootcert=system (fatal ENOENT in Node pg).

# ── Cloudflare R2 ────────────────────────────────────────────
R2_ACCOUNT_ID="your-account-id"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="abc123..."
R2_SECRET_ACCESS_KEY="xyz456..."
R2_BUCKET_NAME="sigma-storage"
R2_PUBLIC_URL=""

# ── Auth (Better Auth) ──────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Cron Jobs ──────────────────────────────────────────
# Secret token for manual cron job trigger (generate with: openssl rand -hex 32)
CRON_SECRET=""

